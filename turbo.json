{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "react-remote#build": {
      "dependsOn": ["react-host#build"]
    },
    "react-remote-2#build": {
      "dependsOn": ["react-host#build"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": false
    }
  }
}
