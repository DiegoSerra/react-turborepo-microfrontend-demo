{
  "name": "react-turbo",
  "description": "Module Federation Vite + React + Turborepo is now possible",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:filter": "turbo run dev --filter",
    "build": "turbo run build",
    "build:filter": "turbo run build --filter",
    "preview": "turbo run preview",
    "preview:filter": "turbo run preview --filter",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@repo/ui": "workspace:*",
    "@repo/components": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/hooks": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.9.12"
  }
}
